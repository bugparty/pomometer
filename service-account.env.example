# ============================================================================
# Google Service Account Configuration
# ============================================================================
# Copy this file to .env.local and fill in your Service Account credentials
# Get these values from your Google Cloud Console > IAM & Admin > Service Accounts
# ============================================================================
# ⚠️ SECURITY WARNING ⚠️
# - Never commit this file to version control
# - Never share these credentials
# - These credentials provide full access to Google Tasks API
# ============================================================================

# Service Account Type (usually "service_account")
SA_TYPE="service_account"

# Google Cloud Project ID
SA_PROJECT_ID="your-project-id-here"

# Service Account Private Key ID
SA_PRIVATE_KEY_ID="your-private-key-id-here"

# Service Account Private Key (IMPORTANT: Keep line breaks as \n)
# Format: -----BEGIN PRIVATE KEY-----\n[base64-encoded-key]\n-----END PRIVATE KEY-----\n
SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_BASE64_ENCODED_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Service Account Client Email (e.g., pomometer-service-account@project.iam.gserviceaccount.com)
SA_CLIENT_EMAIL="your-service-account-email@your-project.iam.gserviceaccount.com"

# Service Account Client ID (OAuth 2.0 client ID)
SA_CLIENT_ID="your-client-id-here"

# OAuth 2.0 Authorization URI
SA_AUTH_URI="https://oauth2.googleapis.com/token"

# OAuth 2.0 Token URI
SA_TOKEN_URI="https://oauth2.googleapis.com/token"

# OAuth 2.0 Auth Provider X.509 Certificate URL
SA_AUTH_PROVIDER_X509_CERT_URL="https://www.googleapis.com/oauth2/v1/certs"

# OAuth 2.0 Client X.509 Certificate URL
SA_CLIENT_X509_CERT_URL="https://www.googleapis.com/robot/v1/metadata/x509/your-service-account-email@your-project.iam.gserviceaccount.com"
