# Copy to `.env.local` and fill in values (`.env.local` is gitignored).
#
# Next.js only injects `NEXT_PUBLIC_*` at dev/build time. Use `.env.local` for local dev;
# `pnpm dev` does NOT load `.env.production` — put the same keys here when developing locally.

# Browser + OAuth (required for “Sign in with Google” UI and token exchange)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Server-side (same Client ID as above; used by API routes)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# OAuth code exchange (required for `/api/auth/google/oauth/callback`; never expose to client)
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App JWT signing
JWT_SECRET=your-long-random-secret

# Optional: remote D1 / Prisma tooling (see prisma.config.ts)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_D1_TOKEN=

# Optional: pull OAuth tokens for one user from remote D1 into `.env.google.synced.local` (gitignored).
# Requires `wrangler login` or CLOUDFLARE_API_TOKEN. Never commit that file.
# pnpm run sync-google-env-from-d1 -- your@email.com
# pnpm run sync-google-env-from-d1 -- --staging your@email.com
# pnpm run sync-google-env-from-d1 -- your@email.com --merge

# Optional: real Google Tasks E2E (`pnpm test:e2e:google-integration`) — shared secret for POST /api/e2e/google-integration-seed
# E2E_GOOGLE_INTEGRATION_SEED_SECRET=generate-a-random-string
